{
  "name": "reqall-console",
  "productName": "Reqall Console",
  "version": "0.1.0",
  "description": "Your Reqall project memory as a keyboard-first console.",
  "license": "MIT",
  "author": "Reqall",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "homepage": "https://www.reqall.net",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "fonts": "node scripts/sync-fonts.mjs",
    "screenshots": "electron scripts/screenshots.mjs",
    "pack": "electron-builder --dir",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "net.reqall.console",
    "productName": "Reqall Console",
    "copyright": "Copyright © 2026 Reqall",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "reqall-console",
      "synopsis": "Your Reqall project memory as a keyboard-first console",
      "artifactName": "Reqall-Console-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Reqall Console",
          "StartupWMClass": "reqall-console"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Reqall-Console-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Reqall-Console-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
